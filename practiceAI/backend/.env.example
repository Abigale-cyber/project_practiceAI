# ========================================
# PracticeAI Docker Compose 环境变量
# 复制此文件为 .env 并根据需要修改
# ========================================

# === PostgreSQL ===
POSTGRES_USER=practiceai
POSTGRES_PASSWORD=practiceai_pass
POSTGRES_DB=practice_ai
POSTGRES_PORT=5433

# === Redis ===
REDIS_PORT=6380

# === Milvus ===
MILVUS_PORT=19530

# === 后端 API ===
API_PORT=8000
UVICORN_WORKERS=2

# === JWT ===
# 生产环境必须修改为强随机密钥: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-strong-random-key

# === CORS ===
# 多个域名用逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# === 大模型配置（SiliconFlow）===
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-R1-Distill-Qwen-14B
EMBEDDING_MODEL=BAAI/bge-m3
