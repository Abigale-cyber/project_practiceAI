# === 数据库（本地 Docker PostgreSQL）===
DATABASE_URL=postgresql://practiceai:practiceai_pass@localhost:5433/practice_ai

# === JWT ===
# 生产环境请使用强随机密钥: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-strong-random-key

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0

# === 大模型配置（SiliconFlow）===
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-R1-Distill-Qwen-14B
EMBEDDING_MODEL=BAAI/bge-m3

# === Milvus 向量数据库 ===
MILVUS_HOST=localhost
MILVUS_PORT=19530
